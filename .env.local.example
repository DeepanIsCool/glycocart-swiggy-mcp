# Server-side LLM key, so users don't need their own. NVIDIA only: its hosted
# models are free. OpenRouter is paid and always runs on the user's own key
# from Settings, so there is deliberately no OPENROUTER_API_KEY.
NVIDIA_API_KEY=

# Optional model overrides. Defaults: nvidia/nemotron-3-ultra-550b-a55b,
# anthropic/claude-3.5-sonnet (OpenRouter, user's key)
NVIDIA_MODEL=
OPENROUTER_MODEL=

# Public origin — must match the redirect URI whitelisted with Swiggy
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32-byte hex. Encrypts session cookies and salts the pseudonymous user id.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SWIGGY_TOKEN_SECRET=

# Neon Postgres. Provision with: vercel install neon
DATABASE_URL=
