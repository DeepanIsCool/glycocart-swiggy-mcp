# LLM provider (server-side fallback so users don't need their own key)
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides. Defaults: nvidia/nemotron-3-ultra-550b-a55b,
# anthropic/claude-3.5-sonnet
NVIDIA_MODEL=
OPENROUTER_MODEL=

# Public origin — must match the redirect URI whitelisted with Swiggy
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32-byte hex. Encrypts session cookies and salts the pseudonymous user id.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SWIGGY_TOKEN_SECRET=

# Neon Postgres. Provision with: vercel install neon
DATABASE_URL=
